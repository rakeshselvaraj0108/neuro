NVIDIA_API_KEY=

# Get a free key at https://build.nvidia.com — API keys start with "nvapi-".
# Copy this file to .env.local and paste your key in there. .env.local is
# gitignored and never committed. Leaving the key empty is a fully
# supported state: the app boots normally and every AI call routes to its
# deterministic fallback (see lib/ai/fallbacks.ts).
#
# NEVER paste a real key into THIS file — .env.example is committed to git.
# Real keys belong only in .env.local.
